# =============================================================
# FincaMarket - Variables de entorno del backend
# Copie este archivo como ".env" y ajuste los valores.
# =============================================================

# Puerto donde corre la aplicación (abrir http://localhost:3001)
PORT=3001
# 127.0.0.1 = solo este computador. Use 0.0.0.0 para abrirlo desde una tableta en la misma red WiFi.
HOST=127.0.0.1

# Conexión a MariaDB / MySQL (XAMPP usa root sin contraseña por defecto)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fincamarket

# Copias de seguridad
# Carpeta donde se guardan los respaldos (relativa a la carpeta backend o ruta absoluta)
BACKUP_DIR=../backups
# Ejecutables de MySQL/MariaDB. En XAMPP para Windows:
MYSQLDUMP_PATH=C:\xampp\mysql\bin\mysqldump.exe
MYSQL_PATH=C:\xampp\mysql\bin\mysql.exe

# Origen permitido para el frontend en modo desarrollo (Vite)
CORS_ORIGIN=http://localhost:5173